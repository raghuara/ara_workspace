# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ara_workspace
# Azure Database for MySQL requires SSL: set DB_SSL=true there, leave it unset locally
DB_SSL=
DB_POOL_SIZE=10

# Auth (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# File storage: local | azure
STORAGE_DRIVER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=ara_workspace
